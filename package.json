{
  "name": "node-task-runtime",
  "version": "0.2.1",
  "description": "A simple, powerful and extensible task execution runtime for Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "task",
    "runtime",
    "worker-threads",
    "child-process",
    "queue",
    "scheduler",
    "concurrency",
    "pool"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
